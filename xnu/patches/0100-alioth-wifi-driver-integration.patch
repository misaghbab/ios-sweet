@@ -0,0 +1,434 @@
+/* From HackiOS's bsd/dev/hakios.net.c (github.com/oosexgang/hackios-xnu-kernel, as
+ * github.com/JopangJovan/hackios-xnu-kernel-umi has it; APSL 2.0), for apollo's Wi-Fi (xnu 0128).
+ * Imported as it is: it was written for a build without -Werror, so its warnings are not
+ * looked at here (this kernel builds with -Weverything -Werror). */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#pragma clang diagnostic ignored "-Weverything"
+/*
+ * en0: a network interface that is Ethernet as far as the rest of the kernel and iOS can tell.
+ *
+ * iOS expects its interfaces from IONetworkingFamily, which this kernel does not have; the BSD
+ * half of the kernel does not need it. The interface is made with the kernel's own interface
+ * KPI, the way bsd/net/if_fake.c makes its "feth": family Ethernet, the stock Ethernet framing
+ * and demultiplexing, one function that is given a frame to send and one call to hand a frame
+ * that has arrived to the stack. What iOS's user space makes of an interface that has no
+ * IOKit object behind it is another matter: see userland/src/net_test.m.
+ *
+ * What carries the frames is a link driver's business; sys/hakios.net.h is all that the two
+ * know of each other. The first link is QEMU's virtio network device (hakios.virtio_net.c).
+ * There can be two interfaces: en0 for the Wi-Fi (or virtio), en1 for the modem's packets
+ * through the IPA (hakios.cell.c); each has its link, its state and its thread.
+ */
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <net/bpf.h>
+#include <net/ethernet.h>
+#include <net/if.h>
+#include <net/if_ether.h>
+#include <net/if_media.h>
+#include <net/if_types.h>
+#include <net/kpi_interface.h>
+#include <netinet/in.h>
+#include <pexpert/pexpert.h>
+#include <sys/kern_event.h>
+#include <sys/kpi_mbuf.h>
+#include <sys/proc.h>
+#include "hakios.net.h"
+#include <sys/sockio.h>
+#include <sys/systm.h>
+
+extern void HakiosWLANStart(const char *interface, const uint8_t *address);  /* iokit/Kernel/hakios.wlan.cpp */
+
+static LCK_GRP_DECLARE(net_lck_grp, "hakios-net");
+
+/* One interface: enN on its link. */
+struct net_if {
+	unsigned        unit;
+	const struct hakios_net_link *link;
+	bool            up;             /* the link says frames can pass */
+	ifnet_t         ifp;
+	lck_mtx_t       tx_lock;        /* one frame at a time to the link */
+	/* What has gone through: said once a minute while anything moves. */
+	struct {
+		uint64_t sent, received, sent_bytes, received_bytes, dropped_out, dropped_in;
+	} count;
+};
+static struct net_if net_ifs[HAKIOS_NET_UNITS];
+
+static inline struct net_if *
+net_if_of(ifnet_t ifp)
+{
+	return ifnet_softc(ifp);
+}
+
+/* The interface on unit `unit`, once attached; NULL before. */
+static struct net_if *
+net_if_unit(unsigned unit)
+{
+	return unit < HAKIOS_NET_UNITS && net_ifs[unit].ifp != NULL ? &net_ifs[unit] : NULL;
+}
+
+/*
+ * Boot-arg net_trace=N: a line in the log for each of the first N frames, either way.
+ * Boot-arg net_names=1: a line for every name asked of a DNS server and for every TCP connection
+ * begun from here -- which is how to see what a system that has just been given a network does
+ * with it (up to NAMES_MAX lines).
+ */
+#define NAMES_MAX       3000
+static uint32_t net_trace, net_names;
+
+static void
+trace_frame(const char *way, const uint8_t *frame, size_t length, size_t whole)
+{
+	static uint32_t said, names;
+	const uint8_t *end = frame + length, *ip = frame + ETHER_HDR_LEN, *l4;
+	uint16_t type;
+	bool ports;
+
+	if (length < ETHER_HDR_LEN + 28 || (said >= net_trace && (!net_names || names >= NAMES_MAX))) {
+		return;
+	}
+	type = (uint16_t)(frame[12] << 8 | frame[13]);
+	l4 = ip + 4 * (ip[0] & 0xf);
+	ports = type == ETHERTYPE_IP && (ip[9] == IPPROTO_TCP || ip[9] == IPPROTO_UDP) && l4 + 4 <= end;
+	if (net_names && names < NAMES_MAX && ports && way[0] == 'o') {
+		if (ip[9] == IPPROTO_UDP && (l4[2] << 8 | l4[3]) == 53 && l4 + 8 + 12 < end) {
+			char name[128];
+			const uint8_t *label = l4 + 8 + 12;
+			size_t n = 0;
+
+			/* the question: lengths and labels, up to a zero */
+			while (label < end && *label != 0 && *label < 64 && label + 1 + *label < end && n + *label + 2 < sizeof(name)) {
+				memcpy(name + n, label + 1, *label);
+				n += *label;
+				name[n++] = '.';
+				label += 1 + *label;
+			}
+			name[n ? n - 1 : 0] = 0;
+			names++;
+			printf("net: asks for the name %s (type %u)\n", name, label + 2 < end ? label[1] << 8 | label[2] : 0);
+		} else if (ip[9] == IPPROTO_TCP && l4 + 14 <= end && (l4[13] & 0x12) == 0x02) {
+			names++;
+			printf("net: connects to %u.%u.%u.%u port %u\n", ip[16], ip[17], ip[18], ip[19], l4[2] << 8 | l4[3]);
+		}
+	}
+	if (said >= net_trace) {
+		return;
+	}
+	said++;
+	if (type == ETHERTYPE_IP) {
+		printf("net: %s %zu bytes: IPv4 %s %u.%u.%u.%u:%u -> %u.%u.%u.%u:%u%s\n", way, whole, ip[9] == IPPROTO_TCP ? "TCP" :
+		    ip[9] == IPPROTO_UDP ? "UDP" : ip[9] == IPPROTO_ICMP ? "ICMP" : "protocol?", ip[12], ip[13], ip[14], ip[15],
+		    ports ? l4[0] << 8 | l4[1] : 0, ip[16], ip[17], ip[18], ip[19], ports ? l4[2] << 8 | l4[3] : 0,
+		    ip[9] == IPPROTO_TCP && ports && l4 + 14 <= end ? (l4[13] & 2 ? " SYN" : l4[13] & 1 ? " FIN" : l4[13] & 4 ? " RST" : "") : "");
+	} else {
+		printf("net: %s %zu bytes: %s (type %#x) to %02x:%02x:%02x:%02x:%02x:%02x\n", way, whole, type == ETHERTYPE_ARP ? "ARP" :
+		    type == ETHERTYPE_IPV6 ? "IPv6" : "?", type, frame[0], frame[1], frame[2], frame[3], frame[4], frame[5]);
+	}
+}
+
+/* ... of a frame on its way out: the start of it is enough */
+static void
+trace_packet(mbuf_t packet, size_t length)
+{
+	uint8_t start[192];
+	size_t have = length < sizeof(start) ? length : sizeof(start);
+
+	if ((net_trace || net_names) && mbuf_copydata(packet, 0, have, start) == 0) {
+		trace_frame("out", start, have, length);
+	}
+}
+
+/* ---- the interface -------------------------------------------------------------------------------- */
+
+/* The stack has a frame to send (a chain of mbufs that starts with the Ethernet header). */
+static errno_t
+net_output(ifnet_t ifp, mbuf_t packet)
+{
+	struct net_if *n = net_if_of(ifp);
+	size_t length = mbuf_pkthdr_len(packet);
+	bool sent = false;
+
+	if (length <= HAKIOS_NET_FRAME_MAX && n->up) {
+		bpf_tap_out(ifp, DLT_EN10MB, packet, NULL, 0);
+		trace_packet(packet, length);
+		lck_mtx_lock(&n->tx_lock);
+		sent = n->link->transmit(packet, length);
+		lck_mtx_unlock(&n->tx_lock);
+	}
+	if (sent) {
+		n->count.sent++;
+		n->count.sent_bytes += length;
+		ifnet_stat_increment_out(ifp, 1, (uint32_t)length, 0);
+	} else {
+		n->count.dropped_out++;
+		ifnet_stat_increment_out(ifp, 0, 0, 1);
+	}
+	mbuf_freem(packet);
+	return 0;
+}
+
+/* A frame has arrived on unit `unit`. */
+void
+hakios_net_input_unit(unsigned unit, const uint8_t *frame, size_t length)
+{
+	struct net_if *n = net_if_unit(unit);
+	struct ifnet_stat_increment_param stats = { .packets_in = 1, .bytes_in = (uint32_t)length };
+	unsigned int chunks = 1;
+	mbuf_t packet = NULL;
+	char *header;
+
+	if (n == NULL) {
+		return;
+	}
+	trace_frame("in ", frame, length, length);
+	if (length < ETHER_HDR_LEN || length > HAKIOS_NET_FRAME_MAX || mbuf_allocpacket(MBUF_DONTWAIT, length, &chunks, &packet) != 0) {
+		n->count.dropped_in++;
+		return;
+	}
+	if (mbuf_copyback(packet, 0, length, frame, MBUF_DONTWAIT) != 0) {
+		mbuf_freem(packet);
+		n->count.dropped_in++;
+		return;
+	}
+	/* as every Ethernet driver hands a frame up: the header noted and stepped over */
+	header = mbuf_data(packet);
+	mbuf_pkthdr_setrcvif(packet, n->ifp);
+	mbuf_pkthdr_setheader(packet, header);
+	mbuf_pkthdr_adjustlen(packet, -ETHER_HDR_LEN);
+	mbuf_setdata(packet, header + ETHER_HDR_LEN, length - ETHER_HDR_LEN);
+	bpf_tap_in(n->ifp, DLT_EN10MB, packet, header, ETHER_HDR_LEN);
+	n->count.received++;
+	n->count.received_bytes += length;
+	ifnet_input(n->ifp, packet, &stats);
+}
+
+void
+hakios_net_input(const uint8_t *frame, size_t length)
+{
+	hakios_net_input_unit(0, frame, length);
+}
+
+static unsigned net_ioctls_said;
+
+static errno_t
+net_ioctl(ifnet_t ifp, u_long command, void *data)
+{
+	struct net_if *n = net_if_of(ifp);
+	/* (a radio says it is one here too: IO80211.framework lists the interfaces whose media is 802.11) */
+	const int media[] = { (n->link->wireless ? IFM_IEEE80211 : IFM_ETHER) | IFM_AUTO };
+	struct ifreq *request = data;
+	struct ifmediareq *media_request = data;
+	user_addr_t list;
+	errno_t error = 0;
+
+	if (n->link->wireless && net_ioctls_said < 80) {
+		char who[32] = "?";
+
+		/* (while iOS's Wi-Fi side is being got to talk to this: who asks the interface what) */
+		proc_selfname(who, sizeof(who));
+		if (strcmp(who, "configd") != 0) {
+			net_ioctls_said++;
+			printf("net: en0 is asked %#lx by %s\n", command, who);
+		}
+	}
+	switch (command) {
+	case SIOCSIFADDR:
+		ifnet_set_flags(ifp, IFF_UP, IFF_UP);
+		break;
+	case SIOCSIFFLAGS:
+		/* running whenever it is up: the link is there or it is not, nothing is switched on */
+		ifnet_set_flags(ifp, (ifnet_flags(ifp) & IFF_UP) ? IFF_RUNNING : 0, IFF_RUNNING);
+		break;
+	case SIOCGIFMEDIA32:
+	case SIOCGIFMEDIA64:
+		/* what configd asks to learn whether the cable is in */
+		list = command == SIOCGIFMEDIA64 ? ((struct ifmediareq64 *)media_request)->ifmu_ulist :
+		    CAST_USER_ADDR_T(((struct ifmediareq32 *)media_request)->ifmu_ulist);
+		media_request->ifm_active = media_request->ifm_current = media[0];
+		media_request->ifm_mask = 0;
+		media_request->ifm_status = IFM_AVALID | (n->up ? IFM_ACTIVE : 0);
+		if (list != USER_ADDR_NULL && media_request->ifm_count > 0) {
+			error = copyout(media, list, sizeof(media));
+		}
+		media_request->ifm_count = 1;
+		break;
+	case SIOCGIFDEVMTU:
+		request->ifr_devmtu.ifdm_current = ifnet_mtu(ifp);
+		request->ifr_devmtu.ifdm_max = ETHERMTU;
+		request->ifr_devmtu.ifdm_min = IF_MINMTU;
+		break;
+	case SIOCSIFMTU:
+		error = request->ifr_mtu > ETHERMTU || request->ifr_mtu < IF_MINMTU ? EINVAL : ifnet_set_mtu(ifp, request->ifr_mtu);
+		break;
+	case SIOCADDMULTI:
+	case SIOCDELMULTI:
+		break;                          /* the link hands us everything anyway */
+	default:
+		/* what iOS's Wi-Fi side asks of a radio's interface: bsd/dev/hakios.apple80211.c */
+		error = n->link->wireless ? hakios_apple80211_ioctl(command, data) : EOPNOTSUPP;
+		break;
+	}
+	return error;
+}
+
+/* Tell whoever listens for kernel events (configd does) that the link is up, or down. */
+static void
+net_link_event(ifnet_t ifp, uint32_t code)
+{
+	_Alignas(struct kern_event_msg) char message[sizeof(struct kern_event_msg) + sizeof(struct net_event_data)] = { 0 };
+	struct kern_event_msg *header = (struct kern_event_msg *)message;
+	struct net_event_data *about = (struct net_event_data *)(header + 1);
+
+	header->total_size = sizeof(message);
+	header->vendor_code = KEV_VENDOR_APPLE;
+	header->kev_class = KEV_NETWORK_CLASS;
+	header->kev_subclass = KEV_DL_SUBCLASS;
+	header->event_code = code;
+	about->if_family = ifnet_family(ifp);
+	about->if_unit = ifnet_unit(ifp);
+	strlcpy(about->if_name, ifnet_name(ifp), IFNAMSIZ);
+	ifnet_event(ifp, header);
+}
+
+void
+hakios_net_link_state_unit(unsigned unit, bool up)
+{
+	struct net_if *n = net_if_unit(unit);
+
+	if (n == NULL || up == n->up) {
+		return;
+	}
+	n->up = up;
+	printf("net: en%u's link (%s) is %s\n", n->unit, n->link->name, up ? "up" : "down");
+	net_link_event(n->ifp, up ? KEV_DL_LINK_ON : KEV_DL_LINK_OFF);
+}
+
+void
+hakios_net_link_state(bool up)
+{
+	hakios_net_link_state_unit(0, up);
+}
+
+/* The interface's own thread: for a link that wants to be asked, and for the minute's line in the log. */
+static void
+net_thread(void *parameter, __unused wait_result_t result)
+{
+	struct net_if *n = parameter;
+	uint64_t said = 0, total;
+	unsigned quiet = 0;
+
+	for (unsigned tick = 1;; tick++) {
+		quiet = n->link->poll != NULL && n->link->poll() ? 0 : quiet + 1;
+		/* about once a minute, if anything has moved since */
+		total = n->count.sent + n->count.received + n->count.dropped_out + n->count.dropped_in;
+		if (tick % 8192 == 0 && total != said) {
+			said = total;
+			printf("net: en%u so far %llu frames sent (%llu bytes), %llu received (%llu bytes); dropped: %llu out, %llu in\n",
+			    n->unit, n->count.sent, n->count.sent_bytes, n->count.received, n->count.received_bytes,
+			    n->count.dropped_out, n->count.dropped_in);
+		}
+		delay_for_interval(quiet < 100 ? 2 : 10, NSEC_PER_MSEC);
+	}
+}
+
+bool
+hakios_net_attach(const struct hakios_net_link *link)
+{
+	unsigned unit = link->unit;
+	struct net_if *n = unit < HAKIOS_NET_UNITS ? &net_ifs[unit] : NULL;
+	char uniqueid[16];
+	struct ifnet_init_eparams init = {
+		.ver = IFNET_INIT_CURRENT_VERSION,
+		.len = sizeof(init),
+		/*
+		 * The simple model: every frame straight to net_output(). And no Skywalk "nexus" made for
+		 * the interface by itself: sockets are all that is asked of it so far.
+		 */
+		.flags = IFNET_INIT_LEGACY | IFNET_INIT_NX_NOAUTO,
+		.uniqueid = uniqueid,
+		.uniqueid_len = 11,
+		.name = "en",
+		.unit = unit,
+		.softc = n,
+		.family = IFNET_FAMILY_ETHERNET,
+		.subfamily = link->wireless ? IFNET_SUBFAMILY_WIFI : IFNET_SUBFAMILY_ANY,
+		.type = IFT_ETHER,
+		.output = net_output,
+		.demux = ether_demux,
+		.add_proto = ether_add_proto,
+		.del_proto = ether_del_proto,
+		.check_multi = ether_check_multi,
+		.framer_extended = ether_frameout_extended,
+		.ioctl = net_ioctl,
+		.broadcast_addr = etherbroadcastaddr,
+		.broadcast_len = ETHER_ADDR_LEN,
+	};
+	const uint8_t *address = link->address;
+	ifnet_t ifp = NULL;
+	thread_t thread;
+	errno_t error;
+
+	if (n == NULL) {
+		printf("net: there is no unit %u for %s\n", unit, link->name);
+		return false;
+	}
+	if (n->link != NULL) {
+		printf("net: en%u is on %s already; %s is not attached\n", unit, n->link->name, link->name);
+		return false;
+	}
+	snprintf(uniqueid, sizeof(uniqueid), "hakios-en%u", unit);
+	n->unit = unit;
+	n->link = link;
+	n->up = link->up;
+	lck_mtx_init(&n->tx_lock, &net_lck_grp, LCK_ATTR_NULL);
+	error = ifnet_allocate_extended(&init, &ifp);
+	if (error != 0) {
+		printf("net: the interface en%u cannot be made: error %d\n", unit, error);
+		n->link = NULL;
+		return false;
+	}
+	ifnet_set_capabilities_enabled(ifp, 0, -1);
+	ifnet_set_addrlen(ifp, ETHER_ADDR_LEN);
+	ifnet_set_baudrate(ifp, 100 * 1000 * 1000);
+	ifnet_set_mtu(ifp, ETHERMTU);
+	ifnet_set_flags(ifp, IFF_BROADCAST | IFF_MULTICAST | IFF_SIMPLEX, 0xffff);
+	ifnet_set_hdrlen(ifp, ETHER_HDR_LEN);
+	ifnet_set_offload(ifp, 0);
+	error = ifnet_attach(ifp, NULL);
+	if (error != 0) {
+		printf("net: the interface en%u cannot be attached: error %d\n", unit, error);
+		ifnet_release(ifp);
+		n->link = NULL;
+		return false;
+	}
+	ifnet_set_lladdr(ifp, address, ETHER_ADDR_LEN);
+	bpfattach(ifp, DLT_EN10MB, ETHER_HDR_LEN);
+	n->ifp = ifp;
+	if (n->up) {
+		net_link_event(ifp, KEV_DL_LINK_ON);
+	}
+	if (link->wireless) {
+		/* (a radio's address is the phone's own: not for the log; and iOS's Wi-Fi side finds the interface by a service) */
+		printf("net: en%u attached on %s (a radio), link %s\n", unit, link->name, n->up ? "up" : "down");
+		HakiosWLANStart(uniqueid + 7, address);
+	} else {
+		printf("net: en%u attached on %s, address %02x:%02x:%02x:%02x:%02x:%02x, link %s\n", unit, link->name, address[0],
+		    address[1], address[2], address[3], address[4], address[5], n->up ? "up" : "down");
+	}
+	if (kernel_thread_start(net_thread, n, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+	return true;
+}
+
+void
+hakios_net_init(void)
+{
+	PE_parse_boot_argn("net_trace", &net_trace, sizeof(net_trace));
+	PE_parse_boot_argn("net_names", &net_names, sizeof(net_names));
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
--- /dev/null
+++ b/bsd/dev/sweet_pcie.c
@@ -0,0 +1,374 @@
+/* PCIe0 bootstrap for the QCA6390 (apollo, SM8250), from the Xiaomi Mi 10
+ * port of github.com/JopangJovan/hackios-xnu-kernel-umi devices/xiaomi-mi-10 (umi_pcie.c, APSL 2.0).
+ * Register values and PHY data are from the merged UMI stock DT and Kona
+ * register definitions; apollo's kona-pcie.dtsi pcie0 PHY sequence, PERST /
+ * CLKREQ / WAKE pins (79/80/81) and wlan-en (20) are the same. This
+ * diagnostic stops with QCA6390 memory decoding enabled and bus mastering
+ * disabled. Comments saying "UMI" describe the Mi 10 where it was measured.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include "sweet_pcie.h"
+#include <sys/errno.h>
+#include "sweet_pcie_phy.h"
+
+#define GCC  0x00100000u
+#define GPIO 0x0f900000u /* Kona NORTH tile: TLMM base + 0x900000. */
+#define PARF 0x01c00000u
+#define PHY  0x01c06000u
+#define DBI  0x60000000u
+#define ATU  0x60001000u
+#define CONF 0x60100000u
+#define BAR  0x60300000u
+#define BIT(n) (1u << (n))
+#define TRY(expr) do { error = (expr); if (error) goto fail; } while (0)
+
+static uint32_t rd(struct sweet_pcie *p, uint32_t addr)
+{
+	return p->io->read32(p->io->context, addr);
+}
+static void wr(struct sweet_pcie *p, uint32_t addr, uint32_t value)
+{
+	p->io->write32(p->io->context, addr, value);
+}
+static void pause_us(struct sweet_pcie *p, unsigned us)
+{
+	p->io->delay_us(p->io->context, us);
+}
+static void report(struct sweet_pcie *p, const char *name, uint32_t value)
+{
+	if (p->io->report) p->io->report(p->io->context, name, value);
+}
+static int update(struct sweet_pcie *p, uint32_t addr, uint32_t clear, uint32_t set)
+{
+	uint32_t value = rd(p, addr);
+	if (value == UINT32_MAX) return EIO;
+	wr(p, addr, (value & ~clear) | set);
+	return 0;
+}
+static int wait_bits(struct sweet_pcie *p, uint32_t addr, uint32_t mask,
+    uint32_t wanted, unsigned timeout_us)
+{
+	uint32_t value = 0;
+	for (unsigned us = 0; us < timeout_us; us += 10) {
+		value = rd(p, addr);
+		if (value == UINT32_MAX) return EIO;
+		if ((value & mask) == wanted) return 0;
+		pause_us(p, 10);
+	}
+	report(p, "poll timeout address", addr);
+	report(p, "poll timeout value", value);
+	return ETIMEDOUT;
+}
+static int gpio_output(struct sweet_pcie *p, unsigned pin, bool high, uint32_t config)
+{
+	/* Set output latch before output-enable/mux to avoid a reset glitch. */
+	int error = update(p, GPIO + pin * 0x1000 + 4, BIT(1), high ? BIT(1) : 0);
+	if (error) return error;
+	return update(p, GPIO + pin * 0x1000, 0x3ff, config | BIT(9));
+}
+static int source_xo(struct sweet_pcie *p, uint32_t cmd)
+{
+	/* 19.2 MHz XO, divide by 1. This is the stock Gen1/Gen2 refgen rate. */
+	int error = update(p, cmd + 4, 0x371f, 1);
+	if (error) return error;
+	error = update(p, cmd, 0, 1);
+	return error ? error : wait_bits(p, cmd, 1, 0, 10000);
+}
+static int branch(struct sweet_pcie *p, uint32_t offset)
+{
+	int error = update(p, GCC + offset, 0, 1);
+	return error ? error : wait_bits(p, GCC + offset, BIT(31), 0, 10000);
+}
+static int clocks(struct sweet_pcie *p)
+{
+	int error;
+	/* GDSC status is checked before accessing the PCIe controller/PHY. */
+	TRY(update(p, GCC + 0x6b004, 7, 0));
+	pause_us(p, 1);
+	TRY(wait_bits(p, GCC + 0x6b004, BIT(31), BIT(31), 10000));
+	TRY(source_xo(p, GCC + 0x6b038));
+	TRY(source_xo(p, GCC + 0x6f014));
+	TRY(branch(p, 0x8c004)); /* QCA6390 reference clock/LDO. */
+	TRY(branch(p, 0x6f02c));
+	TRY(branch(p, 0x9000c));
+	TRY(branch(p, 0x8d058));
+	/* The AXI and PIPE clocks must not retain memory/peripheral state. */
+	TRY(update(p, GCC + 0x6b01c, 0x6000, 0));
+	/* Force diagnostic AHB/SLV clocks on. In HWCG mode the halt bit can
+	 * assert merely because the bus is idle, so it is not a readiness test. */
+	TRY(update(p, GCC + 0x6b014, 0x6002, 0));
+	TRY(update(p, GCC + 0x6b024, BIT(1), 0));
+	TRY(update(p, GCC + 0x6b02c, 0x6000, 0));
+	TRY(update(p, GCC + 0x52008, 0, 0x2f)); /* All PCIe0 votes except PIPE. */
+	static const uint32_t gates[] = {0x6b010, 0x6b014, 0x6b01c, 0x6b024, 0x6b028};
+	for (unsigned i = 0; i < sizeof(gates) / sizeof(gates[0]); i++)
+		TRY(wait_bits(p, GCC + gates[i], BIT(31), 0, 10000));
+	static const uint32_t resets[] = {0x6b000, 0x6c01c};
+	for (unsigned i = 0; i < sizeof(resets) / sizeof(resets[0]); i++) {
+		TRY(update(p, GCC + resets[i], 0, 1));
+		pause_us(p, 1000);
+		TRY(update(p, GCC + resets[i], 1, 0));
+	}
+	return 0;
+fail:
+	return error;
+}
+static int outbound(struct sweet_pcie *p, unsigned index, uint32_t type,
+    uint32_t start, uint32_t end, uint32_t target)
+{
+	uint32_t a = ATU + index * 0x200;
+	wr(p, a + 4, 0);
+	wr(p, a, type);
+	wr(p, a + 8, start);
+	wr(p, a + 12, 0);
+	wr(p, a + 16, end);
+	wr(p, a + 20, target);
+	wr(p, a + 24, 0);
+	wr(p, a + 4, BIT(31));
+	return wait_bits(p, a + 4, BIT(31), BIT(31), 1000);
+}
+
+void sweet_pcie_quiesce(struct sweet_pcie *p)
+{
+	if (!p || !p->io) return;
+	if (p->msi_cap) {
+		uint32_t cap = rd(p, CONF + p->msi_cap);
+		if (cap != UINT32_MAX) wr(p, CONF + p->msi_cap, cap & ~BIT(16));
+		p->msi_cap = 0;
+	}
+	/* Stop protected firmware DMA before asserting reset. Enumeration alone
+	 * never enables bus mastering. Shared power/clock votes remain held. */
+	if (p->dma_enabled) {
+		uint32_t command = rd(p, CONF + 4);
+		if (command != UINT32_MAX) wr(p, CONF + 4, (command & 0xffff) & ~4u);
+		wr(p, DBI + 4, 2);
+		p->dma_enabled = false;
+	}
+	(void)gpio_output(p, 79, false, 1);
+	pause_us(p, 1000); /* PERST propagation before the SMMU can be restored. */
+	(void)gpio_output(p, 20, false, 3 | (7u << 6));
+	p->enumerated = false;
+}
+
+int sweet_pcie_enumerate(struct sweet_pcie *p, const struct sweet_pcie_io *io)
+{
+	if (!p || !io || !io->read32 || !io->write32 || !io->power_on || !io->delay_us)
+		return EINVAL;
+	if (p->io) return EBUSY;
+	p->io = io;
+	int error;
+	TRY(gpio_output(p, 79, false, 1));
+	pause_us(p, 1000);
+	/* The PIPE clock is voted on once the PHY runs (below) and stays voted when the endpoint is
+	 * put in reset: an enumeration after that (ath11k's restart after calibration) would reset
+	 * the controller and PHY with it running. Start every enumeration as the first one does,
+	 * with the vote off (boot 55: the restart's link never came up, errno 60). */
+	TRY(update(p, GCC + 0x52008, BIT(4), 0));
+	TRY(io->power_on(io->context));
+	/* UMI stock pinctrl: CLKREQ mux1/pull-up; WAKE input/pull-up. */
+	TRY(update(p, GPIO + 80 * 0x1000, 0x3ff, 7));
+	TRY(update(p, GPIO + 81 * 0x1000, 0x3ff, 3));
+	TRY(gpio_output(p, 20, true, 3 | (7u << 6)));
+	pause_us(p, 1000);
+	TRY(clocks(p));
+	report(p, "power and clocks ready", rd(p, GCC + 0x6b004));
+	wr(p, PARF + 0x1000, 4); /* Root complex. */
+	TRY(update(p, PARF + 0x40, 1, 0));
+	wr(p, PARF + 0x350, 0);
+	wr(p, PARF, 0x365e);
+	TRY(update(p, PARF + 0x174, 0, BIT(4)));
+	wr(p, PARF + 0x22c, 0); /* No unhandled PCIe interrupts during enumeration. */
+	wr(p, PARF + 0x358, 0x04000000);
+	TRY(update(p, PARF + 0x1a8, 0, BIT(31)));
+	for (unsigned i = 0; i < sizeof(sweet_pcie_phy) / sizeof(sweet_pcie_phy[0]); i++) {
+		wr(p, PHY + sweet_pcie_phy[i].offset, sweet_pcie_phy[i].value);
+		if (sweet_pcie_phy[i].delay_us) pause_us(p, sweet_pcie_phy[i].delay_us);
+	}
+	pause_us(p, 1000);
+	TRY(update(p, GCC + 0x52008, 0, BIT(4))); /* PIPE: vendor skips halt polling. */
+	TRY(wait_bits(p, PHY + 0x814, BIT(6), 0, 100000));
+	report(p, "PHY ready", rd(p, PHY + 0x814));
+	pause_us(p, 10000); /* UMI DT ep-latency=10 ms. */
+	TRY(gpio_output(p, 79, true, 1));
+	pause_us(p, 1000);
+	TRY(update(p, DBI + 0x80c, 0x1f00, 0x100));
+	wr(p, DBI + 0x8a8, 0x20);
+	TRY(update(p, DBI + 0x890, BIT(0), 0));
+	TRY(update(p, DBI + 0x8bc, 0, BIT(0)));
+	wr(p, DBI + 0x154, 0x55555555);
+	TRY(update(p, DBI + 0x8bc, BIT(0), 0));
+	TRY(update(p, DBI + 0xa0, 0xf, 2)); /* Gen2 x1: stock UMI link rate. */
+	/* Write only the control half of the PCIe capability (upper half is W1C). */
+	uint32_t control = rd(p, DBI + 0x78);
+	if (control == UINT32_MAX) { error = EIO; goto fail; }
+	wr(p, DBI + 0x78, (control & 0xffff) & ~0x7000u);
+	TRY(update(p, PARF + 0x1b0, 0, BIT(8)));
+	TRY(wait_bits(p, DBI + 0xf28, BIT(10), BIT(10), 100000));
+	TRY(wait_bits(p, DBI + 0x80, BIT(29), BIT(29), 100000));
+	report(p, "link status", rd(p, DBI + 0x80));
+	wr(p, DBI + 0x18, 0x00010100); /* Primary 0, secondary/subordinate 1. */
+	wr(p, DBI + 0x20, 0x60306030); /* 1 MiB non-prefetchable bridge window. */
+	wr(p, DBI + 0xb40, 0x14); /* AUX 19.2 MHz. */
+	TRY(outbound(p, 0, 4, CONF, CONF + 0xfff, 0x01000000)); /* CFG0, 01:00.0 */
+	uint32_t id = 0;
+	for (unsigned i = 0; i < 1000; i++) {
+		id = rd(p, CONF);
+		if (id == 0x110117cb) break;
+		pause_us(p, 1000);
+	}
+	report(p, "endpoint PCI ID", id);
+	if (id != 0x110117cb) { error = ENODEV; goto fail; }
+	uint32_t command = rd(p, CONF + 4), bar = rd(p, CONF + 0x10);
+	if (command == UINT32_MAX || bar == UINT32_MAX || (bar & 1) ||
+	    ((bar >> 1) & 3) == 1 || ((bar >> 1) & 3) == 3) {
+		error = EIO; goto fail;
+	}
+	/* QCA6390's known 1 MiB BAR; never enable DMA before installing its SMMU. */
+	wr(p, CONF + 4, ((command & 0xffff) & ~7u) | BIT(10));
+	if (rd(p, CONF + 4) & 4) { error = EIO; goto fail; }
+	/* The SID table can contain uninitialized values after reset.
+	 * Initialize this owned, single-endpoint controller like the stock driver,
+	 * after checking QCA6390 identity and disabling endpoint bus mastering. */
+	for (unsigned i = 0; i < 256; i++) {
+		wr(p, PARF + 0x2000 + 4 * i, 0);
+		if (rd(p, PARF + 0x2000 + 4 * i) != 0) { error = EIO; goto fail; }
+	}
+	report(p, "BDF-to-SID table initialized, DMA disabled", 256);
+	wr(p, CONF + 0x10, BAR | (bar & 15));
+	if ((bar & 6) == 4) wr(p, CONF + 0x14, 0);
+	TRY(outbound(p, 1, 0, BAR, BAR + 0xfffff, BAR));
+	wr(p, DBI + 4, 2); /* Root bridge memory decode only. */
+	wr(p, CONF + 4, ((command & 0xffff) & ~7u) | 2 | BIT(10));
+	report(p, "endpoint command", rd(p, CONF + 4));
+	report(p, "endpoint BAR0", rd(p, CONF + 0x10));
+	if ((rd(p, CONF + 4) & 7) != 2 || (rd(p, CONF + 0x10) & ~15u) != BAR) {
+		error = EIO; goto fail;
+	}
+	uint32_t version = rd(p, BAR + 8);
+	report(p, "MHI version (DMA disabled)", version);
+	if (version != 0x01000000) {
+		report(p, "MHI register length", rd(p, BAR));
+		report(p, "MHI control", rd(p, BAR + 0x38));
+		report(p, "MHICFG", rd(p, BAR + 0x10));
+		report(p, "channel doorbells", rd(p, BAR + 0x18));
+		report(p, "event doorbells", rd(p, BAR + 0x20));
+		report(p, "BHI offset", rd(p, BAR + 0x28));
+		report(p, "BHIE offset", rd(p, BAR + 0x2c));
+		if (rd(p, BAR + 0x28) == 0x100) {
+			report(p, "BHI major version", rd(p, BAR + 0x104));
+			report(p, "BHI execution environment", rd(p, BAR + 0x128));
+		}
+	}
+	/* Captured on real UMI PBL: MHIVER has a placeholder, BHI is readable. */
+	bool cold_pbl = version == 0xdeadbeef && rd(p, BAR) == 0x100 &&
+	    rd(p, BAR + 0x18) == 0x300 && rd(p, BAR + 0x20) == 0x700 &&
+	    rd(p, BAR + 0x28) == 0x100 && rd(p, BAR + 0x2c) == 0x224 &&
+	    rd(p, BAR + 0x104) == 1 && rd(p, BAR + 0x128) == 0;
+	if (version != 0x01000000 && !cold_pbl) { error = ENODEV; goto fail; }
+	if (cold_pbl) report(p, "QCA6390 cold PBL signature validated", 1);
+	p->enumerated = true;
+	return 0;
+fail:
+	p->failed = true;
+	report(p, "enumeration failed errno", (uint32_t)error);
+	sweet_pcie_quiesce(p);
+	return error;
+}
+
+int sweet_pcie_enable_dma(struct sweet_pcie *p)
+{
+	if (!p || !p->io || !p->enumerated || p->failed) return ENODEV;
+	if (p->dma_enabled) return EALREADY;
+	/* Kona hashes the two BDF bytes (bus 1, devfn 0) using CRC-8/0x07.
+	 * SID table contains the low byte; PCIe0 supplies the wired 0x1c00 base. */
+	uint8_t hash = 0;
+	const uint8_t bdf[] = {1, 0};
+	for (unsigned i = 0; i < sizeof(bdf); i++) {
+		hash ^= bdf[i];
+		for (unsigned b = 0; b < 8; b++) hash = (uint8_t)((hash << 1) ^ ((hash & 0x80) ? 7 : 0));
+	}
+	uint32_t route = PARF + 0x2000 + 4 * hash;
+	uint32_t old = rd(p, route), wanted = 0x01000100;
+	report(p, "BDF-to-SID route address", route);
+	report(p, "BDF-to-SID previous route", old);
+	if (old != 0 && old != wanted) return EBUSY;
+	wr(p, route, wanted);
+	if (rd(p, route) != wanted) return EIO;
+	uint32_t command = rd(p, CONF + 4);
+	if (command == UINT32_MAX || (command & 7) != 2) return EIO;
+	/* SM8250 defaults to BDF-to-SID bypass. A table alone does not route
+	 * requests through the owned context; explicitly enable translation. */
+	report(p, "BDF-to-SID configuration before", rd(p, PARF + 0x2c00));
+	int error = update(p, PARF + 0x2c00, 1, 0);
+	if (error || (rd(p, PARF + 0x2c00) & 1)) return EIO;
+	report(p, "BDF-to-SID configuration after", rd(p, PARF + 0x2c00));
+	wr(p, DBI + 4, 6); /* Allow protected endpoint transactions upstream. */
+	wr(p, CONF + 4, (command & 0xffff) | 4);
+	p->dma_enabled = true; /* Quiesce must clear it even if readback fails. */
+	if ((rd(p, CONF + 4) & 7) != 6) return EIO;
+	report(p, "protected DMA stream", 0x1c01);
+	return 0;
+}
+
+int sweet_pcie_prepare_radio(struct sweet_pcie *p)
+{
+	if (!p || !p->io || !p->enumerated || p->failed) return ENODEV;
+	if (p->dma_enabled) return EBUSY;
+	/* UMI DT sets qcom,set-wlaon-pwr-ctrl. CNSS clears SHUTDOWN_EN and
+	 * VDD4BLOW_SW_EN in WLAON_QFPROM_PWR_CTRL before the first MHI request.
+	 * This disables those bits; it never enables fuse programming. */
+	uint32_t saved_window = rd(p, BAR + 0x310c);
+	if (saved_window == UINT32_MAX || saved_window == 0xdeadbeef) return EIO;
+	wr(p, BAR + 0x310c, 0x4000003f); /* Internal 0x01f80000 window. */
+	int error = EIO;
+	if ((rd(p, BAR + 0x310c) & 0x4000003f) == 0x4000003f) {
+		uint32_t power = rd(p, BAR + 0x8031c);
+		report(p, "WLAON power control before", power);
+		if (power != UINT32_MAX && power != 0xdeadbeef) {
+			wr(p, BAR + 0x8031c, power & ~5u);
+			uint32_t now = rd(p, BAR + 0x8031c);
+			report(p, "WLAON power control after", now);
+			if (now == (power & ~5u)) error = 0;
+		}
+	}
+	wr(p, BAR + 0x310c, saved_window);
+	return error;
+}
+
+int sweet_pcie_setup_mhi_msi(struct sweet_pcie *p, uint64_t address, uint32_t data)
+{
+	if (!p || !p->io || !p->enumerated || p->failed) return ENODEV;
+	if (p->dma_enabled || p->msi_cap) return EBUSY;
+	if ((address & 3) || data > 0xffff || (data & 31)) return EINVAL;
+	uint32_t cap = rd(p, CONF + 0x34) & 0xff;
+	uint64_t seen = 0;
+	for (unsigned i = 0; i < 48 && cap; i++) {
+		if (cap < 0x40 || cap > 0xfc || (cap & 3) || (seen & (1ull << (cap / 4)))) return EINVAL;
+		seen |= 1ull << (cap / 4);
+		uint32_t header = rd(p, CONF + cap);
+		if (header == UINT32_MAX) return EIO;
+		if ((header & 0xff) == 5) {
+			uint32_t control = header >> 16;
+			bool wide = (control & 0x80) != 0;
+			if (((control >> 1) & 7) < 5 || !(control & 0x100)) return ENOTSUP;
+			if (!wide && address > UINT32_MAX) return ERANGE;
+			uint32_t msg = cap + (wide ? 12 : 8), mask = msg + 4;
+			if (mask > 0xfc) return EINVAL;
+			wr(p, CONF + cap, header & ~BIT(16));
+			wr(p, CONF + mask, UINT32_MAX);
+			wr(p, CONF + cap + 4, (uint32_t)address);
+			if (wide) wr(p, CONF + cap + 8, (uint32_t)(address >> 32));
+			wr(p, CONF + msg, data);
+			wr(p, CONF + mask, 0xfffffff8); /* UMI MHI owns vectors 0, 1 and 2. */
+			wr(p, CONF + cap, (header & ~(0x71u << 16)) | (0x51u << 16));
+			p->msi_cap = cap;
+			if (!(rd(p, CONF + cap) & BIT(16))) return EIO;
+			report(p, "MHI MSI address low", (uint32_t)address);
+			report(p, "MHI MSI data", data);
+			return 0;
+		}
+		cap = (header >> 8) & 0xff;
+	}
+	return ENODEV;
+}
