+	return n;
+}
+
+int
+hakios_wifi_tell(const char *format, ...)
+{
+	char line[512];
+	va_list ap;
+	va_start(ap, format);
+	int n = vsnprintf(line, sizeof(line), format, ap);
+	va_end(ap);
+	printf("SWEET WIFI: %s", line);
