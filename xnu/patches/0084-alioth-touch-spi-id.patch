+/* Exact alioth DT resources/voltages only; no arbitrary regulator interface. */
+int
+alioth_rpmh_touch_power(void)
+{
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	uint32_t vcc = 0, vdd = 0;
+	int error = EIO;
+	if (rh_poisoned) {
+		goto out;
+	}
+	error = rh_map(true);
+	if (!error) {
+		error = rh_lookup("ldoc1", &vcc);
+	}
+	if (!error) {
+		error = rh_lookup("ldoc10", &vdd);
+	}
+	/* Validate both names before any request. Follow Linux: VCC before VDD. */
+	if (!error && vcc == vdd) {
+		error = EINVAL;
+	}
+	if (!error) {
+		printf("ALITOUCH: RPMh VCC ldoc1=1800 mV, then VDD ldoc10=3000 mV\n");
+		error = rh_send(vcc, 1800);
+	}
+	if (!error) {
+		delay(1000);
+		error = rh_send(vdd, 3000);
+	}
+out:
+	/* Leave reset asserted on error; never undo an uncertain/shared rail vote. */
+	printf("ALITOUCH: touch power result=%d\n", error);
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
