+#ifndef ALI_CX_CLOCKS_H
+#define ALI_CX_CLOCKS_H
+#include <stdint.h>
+struct ali_cx_io {
+    void *context;
+    uint32_t (*read)(void *, unsigned, uint32_t);
+    void (*write)(void *, unsigned, uint32_t, uint32_t);
+    void (*delay_us)(void *, unsigned);
+};
+struct ali_cx_result {
+    unsigned stage, writes, retained;
+    uint32_t offset, value;
+};
+/* Bank0=GCC, bank1=GPUCC. Caller serializes access and supplies ordered IO.
+ * Fresh DRV2 MX/CX level codes must be >=256. No ARC vote writes, GX,
+ * firmware, SMMU, or GMU register access. No rollback after uncertainty:
+ * enabled resources remain until reboot. Success means requested controller
+ * states were observed, not GPU execution or all gated clocks running.
+ * Returns0 success,-1 argument/floor,-2 inherited busy,-3 invalid/readback,
+ * -4 bounded timeout. A bus abort is outside this callback contract. */
+int ali_cx_clocks(const struct ali_cx_io *, unsigned, unsigned, struct ali_cx_result *);
+#endif
