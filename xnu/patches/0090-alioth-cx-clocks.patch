+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/* Register sequence adapted from ios-apollo 0096/0097/0099,
+ * commit4c75a006b27b195818849e0a635b5c26ba44bf56.
+ * Copyright (c) 2026 Leo Malik; Copyright (c) 2026 dipa-studio.
+ * MIT; see LICENSE.apollo. Added fail-closed validation and retained-state
+ * semantics: never collapse an inherited domain or lower shared ARC votes. */
+#include "alioth_cx_clocks.h"
+#define ON (1u << 31)
+static int readv(const struct ali_cx_io *io, unsigned bank, uint32_t off,
+                 struct ali_cx_result *r, uint32_t *v)
+{
+    r->offset = off; r->value = *v = io->read(io->context, bank, off);
+    return *v == UINT32_MAX ? -3 : 0;
+}
+static int poll(const struct ali_cx_io *io, unsigned bank, uint32_t off,
+                uint32_t mask, uint32_t want, unsigned attempts, struct ali_cx_result *r)
+{
+    for (unsigned i=0; i<attempts; ++i) {
+        uint32_t v;
+        if (readv(io,bank,off,r,&v)) return -3;
+        if ((v & mask)==want) return 0;
+        io->delay_us(io->context,10);
+    }
+    return -4;
+}
+static int update(const struct ali_cx_io *io, unsigned bank, uint32_t off,
+                  uint32_t mask, uint32_t bits, struct ali_cx_result *r)
+{
+    uint32_t old;
+    if (readv(io,bank,off,r,&old)) return -3;
+    uint32_t next=(old & ~mask)|bits;
+    if (next==old) return 0;
+    ++r->writes; r->retained=1;
+    io->write(io->context,bank,off,next);
+    return poll(io,bank,off,mask,bits,100,r);
+}
+int ali_cx_clocks(const struct ali_cx_io *io, unsigned mx, unsigned cx,
+                  struct ali_cx_result *r)
+{
+    if (!r) return -1;
+    *r=(struct ali_cx_result){0};
+    if (!io || !io->read || !io->write || !io->delay_us || mx<256 || cx<256) return -1;
+    uint32_t v, gdsc, hw, rcg, gmu;
+    int e;
+    r->stage=1;
+    /* Establish configuration-bus access before touching GPUCC. */
+    if (readv(io,0,0x71004,r,&v)) return -3;
+    if ((v & ON) && !(v & 2)) return -2;
+    /* Refuse changing the source of an inherited running GMU or RCG update. */
+    if (readv(io,1,0x106c,r,&gdsc) || readv(io,1,0x1540,r,&hw) ||
+        readv(io,1,0x1120,r,&rcg) || readv(io,1,0x1098,r,&gmu)) return -3;
+    if ((gdsc & 2) || (rcg & 1) || !(gmu & ON) || (gmu & 1)) return -2;
+    /* Check every register we intend to modify before the first write. */
+    const uint32_t gcc[]={0x52000,0x7100c,0x71018,0x71154};
+    const uint32_t cc[]={0x1124,0x109c,0x1078,0x1088,0x108c,0x5000};
+    for(unsigned i=0;i<4;++i) if(readv(io,0,gcc[i],r,&v)) return -3;
+    for(unsigned i=0;i<6;++i) if(readv(io,1,cc[i],r,&v)) return -3;
+    r->stage=2;
+    if ((gdsc & 1) && ((gdsc|hw)&ON)) return -2;
+    if (!(gdsc & 1) && !((gdsc|hw)&ON)) return -2;
+    if (gdsc & 1) {
+        if((e=update(io,1,0x106c,1,0,r))) return e;
+        /* Either GDSCR or its hardware status may report power-on. */
+        unsigned i;
+        for(i=0;i<5000;++i) {
+            if(readv(io,1,0x106c,r,&gdsc)||readv(io,1,0x1540,r,&hw)) return -3;
+            if((gdsc|hw)&ON) break;
+            io->delay_us(io->context,10);
+        }
+        if(i==5000) return -4;
+    }
+    r->stage=3;
+    if((e=update(io,0,0x52000,3u<<15,3u<<15,r))) return e;
+    for(unsigned i=1;i<4;++i) if((e=update(io,0,gcc[i],1,1,r))) return e;
+    r->stage=4;
+    if((e=update(io,1,0x1124,0x371f,0x602,r))) return e;
+    /* UPDATE self-clears; do not demand a readback of the asserted bit. */
+    if(readv(io,1,0x1120,r,&v)) return -3;
+    ++r->writes; r->retained=1;
+    io->write(io->context,1,0x1120,v|1);
+    if((e=poll(io,1,0x1120,1,0,100,r))) return e;
+    if((e=poll(io,1,0x1124,0x371f,0x602,100,r))) return e;
+    r->stage=5;
+    for(unsigned i=1;i<6;++i) {
+        if((e=update(io,1,cc[i],1,1,r))) return e;
+        /* Voted/HW-gated branches are checked for enable only. */
+        if(cc[i]==0x109c && (e=poll(io,1,cc[i],ON,0,100,r))) return e;
+    }
+    if((e=update(io,1,0x1098,1,1,r))) return e;
+    if((e=poll(io,1,0x1098,ON,0,100,r))) return e;
+    r->stage=6;
+    return 0;
+}
+
+#endif
