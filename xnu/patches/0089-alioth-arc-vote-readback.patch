+/* Opt-in RSC READ transactions. These program a command slot but never
+ * request a resource voltage change. Not a passive register snapshot. */
+#include "alioth_arc_transport.h"
+static uint32_t ali_arc_io_read(void *arg, uint32_t off)
+{ (void)arg; return rh_read(rh_tcs, off); }
+static void ali_arc_io_write(void *arg, uint32_t off, uint32_t value)
+{ (void)arg; rh_write(rh_tcs, off, value); }
+static void ali_arc_io_delay(void *arg, unsigned us)
+{ (void)arg; delay(us); }
+
+int alioth_gpu_arc_readback(void);
+int alioth_gpu_arc_readback(void)
+{
+    if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) return EBUSY;
+    int error = EIO;
+    static const char *names[] = {"mx.lvl", "cx.lvl", "gfx.lvl"};
+    struct ali_arc_resource resources[3] = {0};
+    uint32_t values[3] = {0};
+    if (!rh_poisoned) error = rh_map(true);
+    for (unsigned i = 0; !error && i < 3; ++i)
+        error = ali_arc_lookup(names[i], &resources[i]);
+    if (!error && (resources[0].address == resources[1].address ||
+        resources[0].address == resources[2].address ||
+        resources[1].address == resources[2].address)) error = EINVAL;
+    if (!error) {
+        struct ali_arc_transport t = {
+            {NULL, ali_arc_io_read, ali_arc_io_write, ali_arc_io_delay},
+            rh_ncpt, 0
+        };
+        for (unsigned i = 0; !error && i < 3; ++i) {
+            int rc = ali_arc_read(&t, resources[i].address, &values[i]);
+            if (rc) {
+                printf("ALIGPU ARCREAD: resource=%s transport=%d quarantined=%u\n",
+                    names[i], rc, t.poisoned);
+                error = rc == -2 ? EBUSY : rc == -4 ? ETIMEDOUT : EIO;
+            } else if (values[i] >= resources[i].decoded.count) {
+                printf("ALIGPU ARCREAD: resource=%s invalid_raw=%#x count=%u\n",
+                    names[i], values[i], resources[i].decoded.count);
+                error = EINVAL;
+            }
+        }
+        if (t.poisoned) rh_poisoned = true;
+    }
+    if (!error) {
+        for (unsigned i = 0; i < 3; ++i) {
+            unsigned index = values[i];
+            uint8_t *aux = resources[i].aux;
+            unsigned level = aux[2*index] | ((unsigned)aux[2*index+1] << 8);
+            printf("ALIGPU ARCREAD: resource=%s drv=2 index=%u level=%u votes=0\n",
+                names[i], index, level);
+        }
+    }
+    __atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+    return error;
+}
+
 #endif /* ARM64_BOARD_CONFIG_SWEET */
