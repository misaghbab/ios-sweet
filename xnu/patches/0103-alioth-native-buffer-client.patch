+/* Diagnostic NativeAdreno buffer bring-up. No submissions, imports, or Metal
+ * discovery are exposed here. Enable explicitly with sweetnativebuf=1.
+ * Lock order: per-client lock, then gGPULock. Never the reverse. */
+#include <pexpert/pexpert.h>
+#include "NativeAdrenoABI.h"
+extern "C" bool sweet_gpu_address_reserve(uint64_t, uint64_t);
+enum { NATIVE_SLOTS = 128 };
+static const uint64_t nativeWindowSize = 256ull << 20;
+static const uint64_t nativeMaxBuffer = 64ull << 20;
+
+struct native_memory_bo {
+    IOBufferMemoryDescriptor *memory;
+    uint64_t size, charged, iova;
+    uint32_t handle;
+};
+
+class SweetNativeMemoryUserClient : public IOUserClient {
+    OSDeclareDefaultStructors(SweetNativeMemoryUserClient);
+    IOLock *fLock;
+    native_memory_bo *fBO;
+    uint64_t fWindow, fCharged;
+    uint32_t fSerial;
+    bool fClosed;
+    native_memory_bo *find(uint64_t handle) {
+        if (!fBO || !handle || handle > UINT32_MAX) return NULL;
+        for (unsigned i=0; i<NATIVE_SLOTS; ++i)
+            if (fBO[i].memory && fBO[i].handle==handle) return &fBO[i];
+        return NULL;
+    }
+    void destroy(native_memory_bo *b) {
+        if (b->iova) {
+            IOLockLock(gGPULock);
+            sweet_gpu_unmap(b->iova,b->size);
+            IOLockUnlock(gGPULock);
+        }
+        fCharged-=b->charged;
+        b->memory->release();
+        bzero(b,sizeof(*b));
+    }
+    void closeMemory() {
+        if (!fLock) return;
+        IOLockLock(fLock);
+        if (!fClosed) {
+            fClosed=true;
+            if (fBO) for (unsigned i=0;i<NATIVE_SLOTS;++i)
+                if (fBO[i].memory) destroy(&fBO[i]);
+            if (fWindow) {
+                IOLockLock(gGPULock);
+                sweet_gpu_address_free(fWindow,nativeWindowSize);
+                IOLockUnlock(gGPULock);
+                fWindow=0;
+            }
+        }
+        IOLockUnlock(fLock);
+    }
+    IOReturn call(uint32_t method, IOExternalMethodArguments *a);
+public:
+    bool start(IOService *provider) APPLE_KEXT_OVERRIDE {
+        if (!gGPULock || !sweet_gpu_ready() || !IOUserClient::start(provider)) return false;
+        fLock=IOLockAlloc();
+        fBO=IONewZero(native_memory_bo,NATIVE_SLOTS);
+        if (!fLock || !fBO) return false;
+        IOLockLock(gGPULock);
+        /* Disjoint 256MiB apertures, checked against existing OpenGL buffers. */
+        for (uint64_t p=0x20000000ull;p<0x100000000ull;p+=nativeWindowSize)
+            if (sweet_gpu_address_reserve(p,nativeWindowSize)) {fWindow=p;break;}
+        IOLockUnlock(gGPULock);
+        return fWindow!=0;
+    }
+    IOReturn clientClose() APPLE_KEXT_OVERRIDE {
+        closeMemory(); if (!isInactive()) terminate(); return kIOReturnSuccess;
+    }
+    void free() APPLE_KEXT_OVERRIDE {
+        closeMemory();
+        if (fBO) {IODelete(fBO,native_memory_bo,NATIVE_SLOTS);fBO=NULL;}
+        if (fLock) {IOLockFree(fLock);fLock=NULL;}
+        IOUserClient::free();
+    }
+    IOReturn clientMemoryForType(UInt32 type,IOOptionBits *options,IOMemoryDescriptor **memory) APPLE_KEXT_OVERRIDE {
+        if (!fLock || !options || !memory) return kIOReturnBadArgument;
+        *memory=NULL;
+        IOLockLock(fLock);
+        native_memory_bo *b=fClosed?NULL:find(type);
+        if (b) {b->memory->retain();*memory=b->memory;*options=0;}
+        IOLockUnlock(fLock);
+        return b?kIOReturnSuccess:kIOReturnBadArgument;
+    }
+    IOReturn externalMethod(uint32_t method,IOExternalMethodArguments *a,
+        IOExternalMethodDispatch *,OSObject *,void *) APPLE_KEXT_OVERRIDE {
+        if (!fLock || !a || a->scalarInputCount || a->scalarOutputCount ||
+            a->structureInputDescriptor || a->structureOutputDescriptor) return kIOReturnBadArgument;
+        IOLockLock(fLock);
+        IOReturn r=fClosed?kIOReturnNotOpen:call(method,a);
+        IOLockUnlock(fLock);return r;
+    }
+};
+OSDefineMetaClassAndStructors(SweetNativeMemoryUserClient,IOUserClient);
+
+IOReturn SweetNativeMemoryUserClient::call(uint32_t method,IOExternalMethodArguments *a)
+{
+    /* Exact wire sizes, no implicit short writes, no raw user-pointer access. */
+    size_t input=0,output=0;
+    switch(method) {
+    case 0: output=sizeof(uint64_t)*2;break; /* diagnostic aperture, NOT ABI Query */
+    case NativeAdrenoMethodBoAlloc: input=sizeof(NativeAdrenoAbiBoAlloc);output=sizeof(NativeAdrenoAbiBoAllocReply);break;
+    case NativeAdrenoMethodBoMap: input=sizeof(NativeAdrenoAbiBoMap);output=sizeof(NativeAdrenoAbiBoMapReply);break;
+    case NativeAdrenoMethodBoFree: input=sizeof(NativeAdrenoAbiBoFree);break;
+    case NativeAdrenoMethodBoCpuMap: input=sizeof(NativeAdrenoAbiBoCpuMap);output=sizeof(NativeAdrenoAbiBoCpuMapReply);break;
+    case NativeAdrenoMethodBoCpuUnmap: input=sizeof(NativeAdrenoAbiBoCpuUnmap);break;
+    default:return kIOReturnUnsupported;
+    }
+    if (a->structureInputSize!=input || a->structureOutputSize!=output ||
+        (input&&!a->structureInput) || (output&&!a->structureOutput)) return kIOReturnBadArgument;
+    if (!method) {
+        uint64_t reply[2]={fWindow,nativeWindowSize};memcpy(a->structureOutput,reply,sizeof reply);return kIOReturnSuccess;
+    }
+    if (method==NativeAdrenoMethodBoAlloc) {
+        NativeAdrenoAbiBoAlloc r;memcpy(&r,a->structureInput,sizeof r);
+        if (!r.bytes || r.bytes>nativeMaxBuffer || (r.bytes&4095) || r.contiguous ||
+            r.align_log2<12 || r.align_log2>24) return kIOReturnBadArgument;
+        uint64_t charged=round_page_64(r.bytes);
+        if (charged>nativeWindowSize-fCharged || fSerial==UINT32_MAX) return kIOReturnNoResources;
+        native_memory_bo *b=NULL;
+        for (unsigned i=0;i<NATIVE_SLOTS;++i) if (!fBO[i].memory) {b=&fBO[i];break;}
+        if (!b) return kIOReturnNoResources;
+        auto *md=IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+            kIODirectionInOut|kIOMemoryKernelUserShared|kIOMapWriteCombineCache,
+            (vm_size_t)charged,(vm_size_t)(1ull<<r.align_log2));
+        if (!md) return kIOReturnNoMemory;
+        bzero(md->getBytesNoCopy(),(size_t)charged);
+        b->memory=md;b->size=r.bytes;b->charged=charged;b->handle=++fSerial;fCharged+=charged;
+        NativeAdrenoAbiBoAllocReply reply={b->handle};memcpy(a->structureOutput,&reply,sizeof reply);
+        return kIOReturnSuccess;
+    }
+    uint64_t handle;memcpy(&handle,a->structureInput,sizeof handle);
+    native_memory_bo *b=find(handle);if (!b) return kIOReturnBadArgument;
+    if (method==NativeAdrenoMethodBoFree) {destroy(b);return kIOReturnSuccess;}
+    if (method==NativeAdrenoMethodBoCpuMap) {
+        NativeAdrenoAbiBoCpuMapReply reply={b->handle,0,b->size};memcpy(a->structureOutput,&reply,sizeof reply);return kIOReturnSuccess;
+    }
+    if (method==NativeAdrenoMethodBoCpuUnmap) {
+        NativeAdrenoAbiBoCpuUnmap r;memcpy(&r,a->structureInput,sizeof r);
+        return !r.reserved && r.token==b->handle?kIOReturnSuccess:kIOReturnBadArgument;
+    }
+    NativeAdrenoAbiBoMap r;memcpy(&r,a->structureInput,sizeof r);
+    if (b->iova || r.reserved || (r.iova&4095) || r.iova<fWindow ||
+        r.iova-fWindow>=nativeWindowSize || b->size>nativeWindowSize-(r.iova-fWindow) ||
+        (r.permissions!=1 && r.permissions!=3) || r.writeback || r.shareability!=2) return kIOReturnBadArgument;
+    for (unsigned i=0;i<NATIVE_SLOTS;++i) {
+        const native_memory_bo *other=&fBO[i];
+        if (other->memory && other->iova && r.iova<other->iova+other->size && other->iova<r.iova+b->size)
+            return kIOReturnNoResources;
+    }
+    IOLockLock(gGPULock);
+    uint64_t mapped=0;
+    for (;mapped<b->size;mapped+=4096) {
+        IOByteCount length=0;
+        addr64_t phys=b->memory->getPhysicalSegment(mapped,&length,kIOMemoryMapperNone);
+        if (!phys || (phys&4095) || length<4096 || !sweet_gpu_map(r.iova+mapped,phys,r.permissions==1)) break;
+    }
+    if (mapped!=b->size) {
+        /* Unmap the entire validated range, including a possibly partial failed entry. */
+        sweet_gpu_unmap(r.iova,b->size);
+        IOLockUnlock(gGPULock);return kIOReturnNoMemory;
+    }
+    sweet_gpu_mapped();b->iova=r.iova;
+    IOLockUnlock(gGPULock);
+    NativeAdrenoAbiBoMapReply reply={b->iova};memcpy(a->structureOutput,&reply,sizeof reply);
+    return kIOReturnSuccess;
+}
+
+class SweetNativeMemory : public IOService {
+    OSDeclareDefaultStructors(SweetNativeMemory);
+public:
+    bool start(IOService *provider) APPLE_KEXT_OVERRIDE {
+        if (!IOService::start(provider)) return false;
+        setProperty(kIOUserClientClassKey,"SweetNativeMemoryUserClient");
+        setName("SweetNativeMemory");registerService();return true;
+    }
+};
+OSDefineMetaClassAndStructors(SweetNativeMemory,IOService);
+static void startNativeMemory(IOService *provider)
+{
+    unsigned enabled=0;
+    if (!PE_parse_boot_argn("sweetnativebuf",&enabled,sizeof enabled) || enabled!=1) return;
+    auto *service=OSTypeAlloc(SweetNativeMemory);
+    if (!service) return;
+    if (service->init() && service->attach(provider)) {
+        if (!service->start(provider)) service->detach(provider);
+    }
+    service->release();
+}
