From: alioth bring-up
Subject: [PATCH] alioth: touch stage A (read-only SE4/TLMM/GCC diagnostics)

Boot-arg alitouch=1 starts a read-only probe of the POCO F3 (alioth, SM8250)
FocalTech FT3658U touch path: TLMM pins 8-11/33/39, GCC QUP0 S4 clocks and the
GENI SE4 firmware protocol. Only write: OR of 3 QUP0 clock-vote bits.
Default behaviour (without alitouch) is unchanged.

---
diff --git a/bsd/dev/sweet_alitouch.h b/bsd/dev/sweet_alitouch.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/sweet_alitouch.h
@@ -0,0 +1,148 @@
+/*
+ * ALIOTOUCH stage A (POCO F3 / alioth, SM8250): READ-ONLY diagnostics for the
+ * FocalTech FT3658U touch controller on GENI SE4 (SPI, 0x990000).
+ *
+ * Included from sweet_touch.c; started by boot-arg alitouch=1.
+ * Writes: ONLY ORs the three QUP0 clock-vote bits (S4, M_AHB, S_AHB) into
+ * GCC_QUPV3_WRAP_0_CLK_ENA (0x52008), exactly what Linux does. No TLMM
+ * writes, no RPMh votes, no SPI traffic, no GENI register writes.
+ * Facts from live.dts / vendor gcc-kona.c / pinctrl-kona.c:
+ *   TLMM 0xf000000; NORTH tile +0x900000 (GPIO 8..11 = qup4 SPI),
+ *   SOUTH tile +0x500000 (GPIO 33 = reset, GPIO 39 = irq); pin n at +0x1000*n.
+ *   S4 RCG 0x174d0, S4 branch halt 0x174cc, M_AHB halt 0x17004, S_AHB 0x17008.
+ */
+#define ALI_SE_PA        0x00990000u
+#define ALI_GCC_PA       0x00100000u
+#define ALI_GCC_VOTE     0x52008u
+#define ALI_VOTE_BITS    ((1u << 14) | (1u << 6) | (1u << 7))
+#define ALI_RCG          0x174d0u
+#define ALI_HALT_S4      0x174ccu
+#define ALI_HALT_MAHB    0x17004u
+#define ALI_HALT_SAHB    0x17008u
+#define ALI_TLMM_N_PA    0x0f908000u /* 0xf000000 + 0x900000 + 8 * 0x1000 */
+#define ALI_TLMM_S_PA    0x0f520000u /* 0xf000000 + 0x500000 + 32 * 0x1000 */
+
+static vm_offset_t ali_gcc, ali_se, ali_tn, ali_ts;
+static int ali_sleep_chan;
+static bool ali_started;
+
+static uint32_t
+ali_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+ali_wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+ali_wait(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&ali_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+ali_pin(const char *name, vm_offset_t tile, unsigned first, unsigned pin)
+{
+	uint32_t cfg = ali_rd(tile, (pin - first) * 0x1000u);
+	uint32_t io = ali_rd(tile, (pin - first) * 0x1000u + 4u);
+	printf("ALITOUCH: gpio%u %s cfg=%#x (mux=%u pull=%u drv=%u oe=%u) io=%#x (in=%u out=%u)\n",
+	    pin, name, cfg, (cfg >> 2) & 0xfu, cfg & 3u, (cfg >> 6) & 7u, (cfg >> 9) & 1u,
+	    io, io & 1u, (io >> 1) & 1u);
+}
+
+static void
+ali_thread(void *arg, wait_result_t result)
+{
+	unsigned delay_s = 45;
+	(void)arg;
+	(void)result;
+	(void)PE_parse_boot_argn("alitouchdelay", &delay_s, sizeof(delay_s));
+	printf("ALITOUCH: stage A (read-only), starting in %u s\n", delay_s);
+	ali_wait(delay_s * 1000u);
+
+	ali_gcc = ml_io_map(ALI_GCC_PA, 0x60000);
+	ali_tn = ml_io_map(ALI_TLMM_N_PA, 0x4000);
+	ali_ts = ml_io_map(ALI_TLMM_S_PA, 0x8000);
+	if (!ali_gcc || !ali_tn || !ali_ts) {
+		printf("ALITOUCH: MMIO mapping failed gcc=%d tn=%d ts=%d\n",
+		    ali_gcc != 0, ali_tn != 0, ali_ts != 0);
+		goto out;
+	}
+
+	/* 1) Pins first: pure reads of TLMM config. */
+	ali_pin("spi-miso", ali_tn, 8, 8);
+	ali_pin("spi-mosi", ali_tn, 8, 9);
+	ali_pin("spi-clk", ali_tn, 8, 10);
+	ali_pin("spi-cs", ali_tn, 8, 11);
+	ali_pin("ts-reset", ali_ts, 32, 33);
+	ali_pin("ts-irq", ali_ts, 32, 39);
+
+	/* 2) Clocks: show state, OR in our three vote bits only if missing. */
+	uint32_t vote = ali_rd(ali_gcc, ALI_GCC_VOTE);
+	printf("ALITOUCH: gcc vote before=%#x\n", vote);
+	if ((vote & ALI_VOTE_BITS) != ALI_VOTE_BITS) {
+		ali_wr(ali_gcc, ALI_GCC_VOTE, vote | ALI_VOTE_BITS);
+		ali_wait(2);
+	}
+	uint32_t hs4 = ali_rd(ali_gcc, ALI_HALT_S4);
+	uint32_t hm = ali_rd(ali_gcc, ALI_HALT_MAHB);
+	uint32_t hs = ali_rd(ali_gcc, ALI_HALT_SAHB);
+	printf("ALITOUCH: gcc vote after=%#x halt s4=%#x m_ahb=%#x s_ahb=%#x (bit31 = clock off)\n",
+	    ali_rd(ali_gcc, ALI_GCC_VOTE), hs4, hm, hs);
+	printf("ALITOUCH: rcg cmd=%#x cfg=%#x m=%#x n=%#x d=%#x +14=%#x +1c=%#x\n",
+	    ali_rd(ali_gcc, ALI_RCG), ali_rd(ali_gcc, ALI_RCG + 4u),
+	    ali_rd(ali_gcc, ALI_RCG + 8u), ali_rd(ali_gcc, ALI_RCG + 0xcu),
+	    ali_rd(ali_gcc, ALI_RCG + 0x10u), ali_rd(ali_gcc, ALI_RCG + 0x14u),
+	    ali_rd(ali_gcc, ALI_RCG + 0x1cu));
+	if ((hs4 | hm | hs) & (1u << 31)) {
+		printf("ALITOUCH: a clock is still off; NOT touching SE4 registers\n");
+		goto out;
+	}
+
+	/* 3) SE4 read-only: protocol firmware, FIFO sizes, current mode. */
+	ali_se = ml_io_map(ALI_SE_PA, 0x4000);
+	if (!ali_se) {
+		printf("ALITOUCH: SE4 mapping failed\n");
+		goto out;
+	}
+	uint32_t fw = ali_rd(ali_se, 0x68);
+	printf("ALITOUCH: se4 fw=%#x proto=%u (1=SPI 2=UART 3=I2C) status=%#x if_fifo_dis=%#x\n",
+	    fw, (fw >> 8) & 0xffu, ali_rd(ali_se, 0x40), ali_rd(ali_se, 0x64));
+	printf("ALITOUCH: se4 hw_tx=%#x hw_rx=%#x ios=%#x clk_ro=%#x clk_sel=%#x mclk=%#x\n",
+	    ali_rd(ali_se, 0xe24), ali_rd(ali_se, 0xe28), ali_rd(ali_se, 0x908),
+	    ali_rd(ali_se, 0x60), ali_rd(ali_se, 0x7c), ali_rd(ali_se, 0x48));
+	printf("ALITOUCH: se4 spi cpha=%#x cpol=%#x cfg=%#x wlen=%#x dma=%#x\n",
+	    ali_rd(ali_se, 0x224), ali_rd(ali_se, 0x230), ali_rd(ali_se, 0x25c),
+	    ali_rd(ali_se, 0x268), ali_rd(ali_se, 0x258));
+	printf("ALITOUCH: stage A done\n");
+out:
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+alioth_touch_start(void)
+{
+	thread_t thread;
+	if (ali_started) {
+		return;
+	}
+	ali_started = true;
+	kern_return_t kr = kernel_thread_start(ali_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("ALITOUCH: kernel_thread_start failed %d\n", kr);
+	}
+}
diff --git a/bsd/dev/sweet_touch.c b/bsd/dev/sweet_touch.c
--- a/bsd/dev/sweet_touch.c
+++ b/bsd/dev/sweet_touch.c
@@ -21,6 +21,8 @@
 extern int sweet_rpmh_vreg_enable(const char *res, unsigned mv);
 extern void sweet_hid_touch(int finger, int down, int x, int y);
 void sweet_touch_init(void);
+/* alioth (SM8250) bring-up, enabled by boot-arg alitouch=1 */
+#include "sweet_alitouch.h"
 
 #define TOUCH_SE_PA      0x00a84000u
 #define TOUCH_GCC_PA     0x00100000u
@@ -644,6 +646,14 @@
 		return;
 	}
 	st.started = true;
+	{
+		int ali = 0;
+		(void)PE_parse_boot_argn("alitouch", &ali, sizeof(ali));
+		if (ali) {
+			alioth_touch_start();
+			return;
+		}
+	}
 	(void)PE_parse_boot_argn("sweettouch", &enabled, sizeof(enabled));
 	(void)PE_parse_boot_argn("sweettouchirq", &st.irq_hint, sizeof(st.irq_hint));
 	if (!enabled) {
