+
+/* Optional wallpaper extension support. A conflicting existing preference must
+ * never disable the independently verified graphics libraries. No cache deletion.
+ * Carry exactly this reviewed plist; do not accept arbitrary preference payloads.
+ */
+static void
+alioth_wallpaper_install(DTEntry node)
+{
+    static const char path[] = "/private/var/preferences/FeatureFlags/Domain/ExtensionKit.plist";
+    static const char expected[] =
+        "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+        "<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n"
+        "<plist version=\"1.0\"><dict><key>enforce_xpc_cache_code_signing</key>"
+        "<dict><key>Enabled</key><false/></dict></dict></plist>\n";
+    const void *prop = NULL;
+    unsigned int size = 0;
+    if (SecureDTGetProperty(node, "wallpaper-extensionkit", &prop, &size) != kSuccess) return;
+    int error = EINVAL;
+    if (size == sizeof(expected)-1 && !memcmp(prop, expected, size))
+        error = sweet_file_write(path, prop, size);
+    printf("ALIOTH WALLPAPER: ExtensionKit preference %s (error %d)\n",
+        error == 0 ? "verified" : "not installed", error);
+}
