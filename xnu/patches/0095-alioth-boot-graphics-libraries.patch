+Only three graphics libraries; sweetfiles=1 required. Creates missing files;
+existing files must match byte-for-byte. Installs before launchd, persists on root.
+*/
+#include <pexpert/arm64/board_config.h>
+
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/fcntl.h>
+#include <sys/vnode.h>
+#include <sys/uio.h>
+#include <sys/proc.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+
+void sweet_files_install(void);
+int sweet_kernel_mkdir(const char *path, mode_t mode);
+
+/* Alioth: only the three pinned graphics libraries, with explicit opt-in.
+ * Existing content is compared, never truncated. Partial/foreign content fails closed.
+ */
+bool alioth_files_ready = false;
+static const char *const allowed_files[] = {
+    "/usr/local/lib/libOSMesa.8.dylib",
+    "/usr/local/lib/libsweet-gl.dylib",
+    "/usr/local/lib/libsweet-ca.dylib"
+};
+static bool sweet_file_allowed(const char *path)
+{
+    for (unsigned i=0;i<3;i++) if (!strcmp(path,allowed_files[i])) return true;
+    return false;
+}
+
+static int sweet_file_verify(const char *path,const uint8_t *data,size_t size)
+{
+    vfs_context_t ctx=vfs_context_kernel(); vnode_t vp=NULLVP;
+    int error=vnode_open(path,FREAD|O_NOFOLLOW,0,0,&vp,ctx);
+    if (error) return error;
+    struct vnode_attr va; VATTR_INIT(&va); VATTR_WANTED(&va,va_data_size);
+    error=vnode_getattr(vp,&va,ctx);
+    if (!error && (vnode_vtype(vp)!=VREG || !VATTR_IS_SUPPORTED(&va,va_data_size) || va.va_data_size!=size)) error=EINVAL;
+    char buf[1024];
+    for (size_t pos=0; !error && pos<size;) {
+        int len=(int)((size-pos)>sizeof(buf)?sizeof(buf):size-pos),resid=0;
+        error=vn_rdwr(UIO_READ,vp,buf,len,(off_t)pos,UIO_SYSSPACE,IO_NOAUTH,
+            vfs_context_ucred(ctx),&resid,vfs_context_proc(ctx));
+        if (!error && (resid || memcmp(buf,data+pos,len))) error=EIO;
+        pos+=len;
+    }
+    vnode_close(vp,FREAD,ctx); return error;
+}
+
+/* The folders PATH's file goes in, those that are not there yet made. */
+static int
+sweet_file_folders(const char *path)
+{
+	char folder[1024];
+	size_t length = strlcpy(folder, path, sizeof(folder));
+
+	for (size_t i = 1; i < length && i < sizeof(folder); i++) {
+		if (folder[i] != '/') {
+			continue;
+		}
+		folder[i] = '\0';
+		int error = sweet_kernel_mkdir(folder, 0755);
+		if (error == 0) {
+			printf("SWEET FILES: %s: folder made\n", folder);
+		} else if (error != EEXIST) {
+			printf("SWEET FILES: %s: folder NOT made (error %d)\n", folder, error);
+			return error;
+		}
+		folder[i] = '/';
+	}
+	return 0;
+}
+
+static int
+sweet_file_write(const char *path, const uint8_t *data, size_t size)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	int mode = strncmp(path, "/usr/local/", 11) == 0 ? 0755 : 0644;
+	int error;
+
+	error = vnode_open(path, O_CREAT | O_EXCL | FWRITE | O_NOFOLLOW, mode, 0, &vp, ctx);
+	if (error == ENOENT && sweet_file_folders(path) == 0) {
+		error = vnode_open(path, O_CREAT | O_EXCL | FWRITE | O_NOFOLLOW, mode, 0, &vp, ctx);
+	}
+	if (error == EEXIST) return sweet_file_verify(path,data,size);
+	if (error != 0) {
+		return error;
+	}
+	/* in pieces: vn_rdwr takes an int length */
+	for (size_t done = 0; done < size && error == 0;) {
+		size_t chunk = size - done > (1u << 20) ? (1u << 20) : size - done;
+		int resid = 0;
+
+		error = vn_rdwr(UIO_WRITE, vp, (caddr_t)(uintptr_t)(data + done), (int)chunk, (off_t)done,
+		    UIO_SYSSPACE, IO_NOAUTH | IO_SYNC, vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+		if (error == 0 && resid != 0) {
+			error = EIO;
+		}
+		done += chunk;
+	}
+	vnode_close(vp, FWRITE, ctx);
+	return error ? error : sweet_file_verify(path,data,size);
+}
+
+void
+sweet_files_install(void)
+{
+	uint32_t enabled = 0;
+	DTEntry node;
+
+	(void)PE_parse_boot_argn("sweetfiles", &enabled, sizeof(enabled));
+	if (enabled != 1 || SecureDTLookupEntry(NULL, "/sweet-files", &node) != kSuccess) {
+		return;
+	}
+	unsigned seen=0; bool failed=false;
+	for (unsigned i = 0; i < 3; i++) {
+		char name[16];
+		const void *prop = NULL;
+		unsigned int size = 0;
+
+		snprintf(name, sizeof(name), "file%u", i);
+		if (SecureDTGetProperty(node, name, &prop, &size) != kSuccess) {
+			break;
+		}
+		const char *path = prop;
+		size_t len = strnlen(path, size < 1024 ? size : 1024);
+		if (len == 0 || len >= size || len >= 1024 || !sweet_file_allowed(path) || strcmp(path,allowed_files[i])) {
+			printf("SWEET FILES: %s: not a path that may be written; not written\n", name);
+			failed=true; continue;
+		}
+		const uint8_t *data = (const uint8_t *)prop + len + 1;
+		size_t bytes = size - len - 1;
+		int error = bytes == 0 || bytes > (20u<<20) ? EINVAL : sweet_file_write(path, data, bytes);
+		seen++; if (error) failed=true;
+		printf("SWEET FILES: %s: %zu bytes %s (error %d)\n", path, bytes, error == 0 ? "written" : "NOT written", error);
+	}
+	alioth_files_ready=seen==3 && !failed;
+	printf("ALIGPU FILES: verified=%u ready=%u\n",seen,alioth_files_ready);
+}
+
+#endif /* ARM64_BOARD_CONFIG_SWEET */
