+++ b/bsd/dev/alioth_arc_levels.c
@@ -0,0 +1,36 @@
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include "alioth_arc_levels.h"
+
+/* Downstream rpmh-regulator.c:1263: 1..16 little-endian u16 values;
+ * zero after the first entry terminates the map. Be stricter about padding
+ * and ordering so corrupted data cannot become a power command index. */
+int ali_arc_select(const uint8_t *aux, size_t bytes, uint16_t minimum,
+    struct ali_arc_level *out)
+{
+    if (!aux || !out || bytes < 2 || bytes > 32 || (bytes & 1)) return -1;
+    uint16_t previous = 0;
+    unsigned count = 0, padded = 0, found = 0;
+    struct ali_arc_level selected = {0};
+    for (unsigned i = 0; i < bytes / 2; ++i) {
+        uint16_t level = (uint16_t)(aux[2*i] | ((uint16_t)aux[2*i+1] << 8));
+        if (i && !level) padded = 1;
+        if (padded) {
+            if (level) return -1;
+            continue;
+        }
+        if (i && level < previous) return -1;
+        previous = level;
+        ++count;
+        if (!found && level >= minimum) {
+            selected.level = level;
+            selected.index = (uint8_t)i;
+            found = 1;
+        }
+    }
+    if (!found) return -2;
+    selected.count = (uint8_t)count;
+    *out = selected;
+    return 0;
+}
+
+#endif
--- /dev/null
+++ b/bsd/dev/alioth_arc_levels.h
@@ -0,0 +1,14 @@
+#ifndef ALI_ARC_LEVELS_H
+#define ALI_ARC_LEVELS_H
+#include <stddef.h>
+#include <stdint.h>
+struct ali_arc_level {
+    uint16_t level;
+    uint8_t index, count;
+};
+/* Decode cmd-db ARC auxiliary data; never accepts a millivolt VRM request.
+ * Caller must first validate resource name, ARC slave/address and DB bounds.
+ * Failure leaves output unchanged. No hardware access or voting occurs. */
+int ali_arc_select(const uint8_t *aux, size_t bytes, uint16_t minimum,
+    struct ali_arc_level *out);
+#endif
