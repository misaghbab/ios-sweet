+/* Read-only command DB inspection. Caller holds rh_lock; no RPMh writes. */
+#include "alioth_arc_levels.h"
+struct ali_arc_resource {
+    uint32_t address;
+    uint16_t version;
+    uint8_t aux[32];
+    unsigned bytes;
+    struct ali_arc_level decoded;
+};
+
+static int
+ali_arc_lookup(const char *name, struct ali_arc_resource *out)
+{
+    uint32_t key[2] = {0, 0};
+    for (unsigned i = 0; i < 8 && name[i]; ++i)
+        key[i / 4] |= (uint32_t)(uint8_t)name[i] << (8u * (i % 4));
+    unsigned matches = 0;
+    struct ali_arc_resource found = {0};
+    for (unsigned i = 0; i < 8; ++i) {
+        uint32_t h = 8 + 16 * i;
+        unsigned slave = rh_db16(h);
+        if (!slave) break;
+        uint32_t entries = RH_DB_HEADER + rh_db16(h + 2);
+        uint32_t aux = RH_DB_HEADER + rh_db16(h + 4);
+        unsigned count = rh_db16(h + 6);
+        if (slave < 3 || slave > 5 || (entries & 3) || count > 1024 ||
+            !rh_range(entries, count * RH_DB_ENTRY) || !rh_range(aux, 0))
+            return EINVAL;
+        for (unsigned j = 0; j < count; ++j) {
+            uint32_t e = entries + j * RH_DB_ENTRY;
+            if (rh_read(rh_db, e) != key[0] || rh_read(rh_db, e + 4) != key[1])
+                continue;
+            uint32_t addr = rh_read(rh_db, e + 16);
+            unsigned len = rh_db16(e + 20);
+            uint32_t start = aux + rh_db16(e + 22);
+            if (++matches != 1 || slave != 3 || (addr >> 16) != 3 ||
+                (addr & 3) || len < 2 || len > 32 || (len & 1) ||
+                (start & 1) || !rh_range(start, len)) return EINVAL;
+            for (unsigned k = 0; k < len; k += 2) {
+                uint16_t v = rh_db16(start + k);
+                found.aux[k] = (uint8_t)v;
+                found.aux[k + 1] = (uint8_t)(v >> 8);
+            }
+            if (ali_arc_select(found.aux, len, 0, &found.decoded)) return EINVAL;
+            found.address = addr;
+            found.version = rh_db16(h + 8);
+            found.bytes = len;
+        }
+    }
+    if (matches != 1) return ENODEV;
+    *out = found;
+    return 0;
+}
+
+int alioth_gpu_arc_probe(void);
+int
+alioth_gpu_arc_probe(void)
+{
+    if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) return EBUSY;
+    int error = EIO;
+    static const char *names[] = {"mx.lvl", "cx.lvl", "gfx.lvl"};
+    struct ali_arc_resource resources[3] = {0};
+    if (!rh_poisoned) error = rh_map(true);
+    for (unsigned i = 0; !error && i < 3; ++i)
+        error = ali_arc_lookup(names[i], &resources[i]);
+    if (!error && (resources[0].address == resources[1].address ||
+        resources[0].address == resources[2].address ||
+        resources[1].address == resources[2].address)) error = EINVAL;
+    if (!error) {
+        for (unsigned i = 0; i < 3; ++i) {
+            struct ali_arc_resource *r = &resources[i];
+            printf("ALIGPU ARC: resource=%s address=%#x version=%#x count=%u readonly=1\n",
+                names[i], r->address, r->version, r->decoded.count);
+            for (unsigned j = 0; j < r->decoded.count; ++j)
+                printf("ALIGPU ARC: resource=%s index=%u level=%u\n", names[i], j,
+                    (unsigned)(r->aux[2*j] | ((unsigned)r->aux[2*j+1] << 8)));
+        }
+    }
+    __atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+    return error;
+}
+
 #endif /* ARM64_BOARD_CONFIG_SWEET */
